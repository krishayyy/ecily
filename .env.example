# Google Apps Script web app URL that appends form submissions to your Sheet.
# Get it by following scripts/sheet-webhook.gs, then set this in Vercel.
# Until this is set, forms still work but submissions are only logged, not stored.
SHEET_WEBHOOK_URL=

# --- Ecily Research (research.ecily.org / /research) ---

# Groq API key for answer synthesis. Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Tavily API key for domain-restricted web search (.gov/.edu/credible orgs).
# Free tier: https://tavily.com. OpenAlex and Semantic Scholar need no key.
TAVILY_API_KEY=

# Optional: a contact email for OpenAlex's "polite pool", which gets faster,
# more reliable rate limits than anonymous requests. Any address works.
OPENALEX_MAILTO=

# Supabase project — powers accounts and saved searches.
# https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
