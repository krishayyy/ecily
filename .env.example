# Google Apps Script web app URL that appends form submissions to your Sheet.
# Get it by following scripts/sheet-webhook.gs, then set this in Vercel.
# Until this is set, forms still work but submissions are only logged, not stored.
SHEET_WEBHOOK_URL=

# Website Maker publishing (ecily.org/s/<name>). Needs a free Upstash Redis
# database: create one at console.upstash.com and copy its REST URL + token.
# (If you add Upstash through Vercel's Storage tab instead, it sets
# KV_REST_API_URL / KV_REST_API_TOKEN, which also work.)
# Until these are set, the Publish button says publishing isn't switched on yet.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any long random string. Lets you take down a published site:
#   curl -X DELETE https://ecily.org/api/sites/<name> -H "Authorization: Bearer <this>"
SITES_ADMIN_TOKEN=
